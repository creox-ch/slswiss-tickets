# ── Payrexx ──────────────────────────────────────────────
PAYREXX_INSTANCE=slswiss
PAYREXX_API_SECRET=            # Payrexx → Settings → API → API Secret
PAYREXX_WEBHOOK_SIGNING_KEY=   # signing key вебхука (создаётся при добавлении вебхука)
# Без signing key вебхук ОТКЛОНЯЕТСЯ (fail-closed). Только на время настройки
# можно временно разрешить неподписанные вебхуки:
# ALLOW_UNSIGNED_WEBHOOKS=1

# ── Билет ────────────────────────────────────────────────
TICKET_PRICE_RAPPEN=100        # цена билета в раппенах (100 = 1.00 CHF); клиент цену НЕ присылает
CHECKIN_STAFF_KEY=             # ключ персонала для /api/checkin; пусто = чек-ин без ключа (только тест!)

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://dwcmiommviauwzkhkbki.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # Supabase → Settings → API → service_role (СЕКРЕТ, только сервер!)

# ── Resend ───────────────────────────────────────────────
RESEND_API_KEY=
TICKET_FROM_EMAIL=SoiLüDi <noreply@slswiss.ch>

# ── Формы платформы (POST /api/forms) ────────────────────
# Origins сайтов, которым разрешено слать заявки, через запятую.
# ВНИМАНИЕ: значение ЦЕЛИКОМ заменяет DEFAULT_ORIGINS из lib/forms.js —
# задав её, дописывай сюда каждый новый сайт, иначе он получит 403.
# Пустая / из одних запятых → откат на дефолт (чтобы не положить приём заявок).
FORMS_ALLOWED_ORIGINS=
# Куда слать уведомления о заявках — ОБЩИЙ запасной ящик.
# Используется, если сайта нет в FORMS_NOTIFY_MAP. Пусто → assistant@creox.ch.
FORMS_NOTIFY_EMAIL=
# Уведомления по сайтам: 'source=ящик' через запятую. Чтобы заявки форума
# не падали в ящик chudina и наоборот. Имеет приоритет над FORMS_NOTIFY_EMAIL.
# Пример: forum=info@frankenplatz.ch,chudina=main@chudina.me,creox=assistant@creox.ch
# Боевая настройка (решение 2026-08-07): forum=info@frankenplatz.ch —
# остальные сайты падают на дефолт main@creox.ch, отдельных ключей им не нужно.
FORMS_NOTIFY_MAP=
# СКРЫТАЯ копия (BCC) каждого уведомления. Пусто → без копии,
# не задано → assistant@creox.ch. Прежнее имя FORMS_NOTIFY_CC ещё читается.
# Именно BCC: Reply-To ведёт на заявителя, видимый CC при «ответить всем»
# раскрыл бы служебный адрес постороннему.
FORMS_NOTIFY_BCC=
# Секрет ОБОИХ cron-роутов: сводка подписок (/api/cron/newsletter-digest) и
# чистка брошенных корзин (/api/cron/cleanup-pending).
# Vercel Cron шлёт его как `Authorization: Bearer $CRON_SECRET`.
# Если не задан — роуты отключены (503), а не открыты всем: один отдаёт e-mail
# подписчиков, второй меняет и удаляет строки в таблице билетов.
CRON_SECRET=
# Отправитель письма-ОТЧЁТА, который уходит самому юзеру (калькуляторы форума,
# флаг send_report). Пусто → Frankenplatz <noreply@frankenplatz.ch>.
# Домен обязан быть верифицирован в Resend, иначе отправка падает.
FORMS_REPORT_FROM=

# ── Брошенные корзины (/api/cron/cleanup-pending) ────────
# Обе необязательные, дефолты рабочие. Пустое/кривое значение → дефолт.
# Через сколько ЧАСОВ неоплаченный билет помечается failed (дефолт 24).
# Строка остаётся: failed → paid разрешён, поздняя оплата билет всё равно выдаст.
PENDING_ABANDON_HOURS=
# Через сколько ДНЕЙ брошенная корзина удаляется совсем (дефолт 30, минимум 7).
# Удаляются только строки, по которым Payrexx не сказал ни слова.
PENDING_PURGE_DAYS=

# ── Прочее ───────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3000   # в проде: https://tickets.slswiss.ch (или vercel-домен)

# (DEV_ISSUE_TOKEN и app/api/dev удалены 2026-07-12 — тест без оплаты больше не нужен,
#  Payrexx работает вживую. Не возвращай этот бэкдор в прод.)
